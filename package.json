{
  "name": "kendai-md",
  "version": "0.2.0",
  "description": "A local Markdown reader for your project's documentation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karad/kendai-md.git"
  },
  "homepage": "https://github.com/karad/kendai-md#readme",
  "author": {
    "name": "karad",
    "url": "https://github.com/karad"
  },
  "bugs": {
    "url": "https://github.com/karad/kendai-md/issues"
  },
  "keywords": [
    "markdown",
    "viewer",
    "cli",
    "local",
    "documentation"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "kendai": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "doc"
  ],
  "engines": {
    "node": ">=24.22.0"
  },
  "scripts": {
    "kendai": "npm run compile --silent && node dist/cli.js",
    "compile": "node scripts/compile.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts test/*.test.tsx",
    "check": "npm run format:check && npm run typecheck && npm test && npm run compile",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:package": "node scripts/verify-package.mjs",
    "install:local": "node scripts/install-local.mjs",
    "prepare": "npm run compile",
    "prepublishOnly": "npm run check && npm run test:package",
    "benchmark:tui": "npm run compile --silent && node scripts/benchmark-tui.mjs",
    "test:tui:pty": "node scripts/verify-tui-terminal.mjs"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "cli-highlight": "2.1.11",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.11.1",
    "ink": "8.0.0",
    "markdown-it": "^14.1.0",
    "open": "^10.2.0",
    "react": "19.3.0",
    "sanitize-html": "^2.17.0",
    "string-width": "8.3.0",
    "strip-ansi": "7.2.0",
    "wrap-ansi": "10.0.2"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/sanitize-html": "^2.16.0",
    "ink-testing-library": "4.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
